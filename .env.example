# 网盘拉新唯一配置文件
# 复制为 .env 并填写实际值；.env 已被 .gitignore 忽略。
# 所有配置统一在此文件，不再支持 config.yaml。

# 全局默认
COUNT=5
CACHE_EXPIRE_HOURS=24
TARGET_FOLDER=转存资源

# 企业微信机器人（两种字段名都支持）
WECHAT_WEBHOOK_URL=

# 百度网盘
BAIDU_COOKIE=
# BAIDU_COUNT=          # 留空则用全局 COUNT
# BAIDU_TARGET_FOLDER=  # 留空则用全局 TARGET_FOLDER

# 夸克网盘
QUARK_COOKIE=
KUAKE_COOKIE=          # kuake-v1.5.0 CLI 专用（同 QUARK_COOKIE，CLI 会自动读 .env）
# QUARK_COUNT=          # 留空则用全局 COUNT
# QUARK_KUAKE_CLI=      # 留空则按系统自动选择默认路径
QUARK_FOLDER_FID=0
QUARK_YINLIU_PDF=assets/333333.pdf
QUARK_YINLIU_PROBABILITY=0.0
QUARK_YINLIU_SUBDIR=自动转存
