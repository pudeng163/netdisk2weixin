# 网盘拉新唯一配置文件
# 复制�?.env 并填写实际值；.env 已被 .gitignore 忽略�?# 所有配置统一在此文件，不再支�?config.yaml�?
# 全局默认
COUNT=5
CACHE_EXPIRE_HOURS=24
TARGET_FOLDER=转存资源


# ===== 数据来源：本地资源池 / PanSou API =====
# 默认优先读取项目根目录的「资源池.json」（由 tools/list_resources.py 导出），
# 读取失败或不存在时自动回退到 PanSou API。
LOCAL_POOL_ENABLED=true            # false 时强制走 API
RESOURCE_POOL_FILE=资源池.json      # 相对项目根目录，也可填绝对路径

# ===== PanSou 服务地址（不填则用默认值）=====
# 修改端口后无需改任何代码，Python 侧与启动器共用这份配置。
PANSOU_HOST=127.0.0.1              # 用 127.0.0.1 而非 localhost，避免 IPv6 解析差异
PANSOU_PORT=8888
# PANSOU_API_URL=                  # 设置后完全覆盖上面两项拼出的搜索地址
# PANSOU_ENABLED_PLUGINS=          # 留空则自动读取 pansou/docker-compose.yml 的插件列表
# PANSOU_CHANNELS=                 # 同上，留空则读 docker-compose.yml

# 企业微信机器人（两种字段名都支持）
WECHAT_WEBHOOK_URL=

# 百度网盘
BAIDU_COOKIE=
# BAIDU_COUNT=          # 留空则用全局 COUNT
# BAIDU_TARGET_FOLDER=  # 留空则用全局 TARGET_FOLDER

# 夸克网盘
QUARK_COOKIE=
KUAKE_COOKIE=          # kuake-v1.5.0 CLI 专用（同 QUARK_COOKIE，CLI 会自动读 .env）
# QUARK_COUNT=          # 留空则用全局 COUNT
# QUARK_KUAKE_CLI=      # 留空或填 auto = 按当前系统/架构自动选择（推荐）
#                       #   填具体路径 = 显式指定，跳过自动识别
#                       #   支持 Windows / Linux(x64/arm64) / macOS(x64, arm64 走 Rosetta)
QUARK_FOLDER_FID=0
QUARK_YINLIU_PDF=assets/99999.pdf
QUARK_YINLIU_PROBABILITY=0.0
QUARK_YINLIU_SUBDIR=自动转存

# ===== 飞书多维表格（可选，开启后自动写入）=====
# 在 https://open.feishu.cn/app 创建自建应用
# 需要权限: wiki:wiki:readonly + bitable:app
# 还需要把应用添加为目标文档的协作者（wiki 页面右上角... → 添加文档应用）
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_NODE_TOKEN=    # wiki 页面 URL 里 /wiki/ 后面那串
FEISHU_TABLE_ID=            # 多维表格 URL 里 ?table= 后面那串
